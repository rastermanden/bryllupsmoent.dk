# Self-hosted Plausible Analytics (see README.md for setup instructions).
# Only used in production builds; the tracking script is not injected when
# VITE_PLAUSIBLE_HOST is unset, so these are optional for local development.

# Hostname of your self-hosted Plausible instance, e.g. analytics.example.com
VITE_PLAUSIBLE_HOST=

# Site domain reported to Plausible. Defaults to "bryllupsmønt.dk" if unset.
VITE_PLAUSIBLE_DOMAIN=
